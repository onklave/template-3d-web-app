# The web stage does `COPY . .`, so anything not excluded here enters the build
# context. Keep local-only files out: Vite loads .env* at build time and inlines
# every VITE_-prefixed value into the shipped bundle, so a stray .env.local can
# put a local secret in a public artifact.
node_modules
dist
.git
.gitignore
*.local
.env.local
.env.*.local
.DS_Store
